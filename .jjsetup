#!/bin/sh

# SPDX-FileCopyrightText: 2025 Jean-Philippe Cugnet <jean-philippe@cugnet.eu>
# SPDX-License-Identifier: EUPL-1.2

set -e
set -x

# Track integration bookmarks.
jj bookmark track main@origin
jj bookmark track develop@origin

# Configure immutable heads.
jj config set --repo 'revset-aliases."trunk()"' 'main@origin'
jj config set --repo \
    'revset-aliases."immutable_heads()"' \
    'builtin_immutable_heads() | develop@origin'
